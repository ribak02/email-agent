# === OpenAI ===
OPENAI_API_KEY=sk-your-key-here

# === Microsoft Azure App Registration ===
# Register at portal.azure.com -> Azure AD -> App registrations
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-from-azure-portal
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Must match redirect URI registered in Azure
AZURE_REDIRECT_URI=https://your-app.up.railway.app/auth/callback

# === Meta / WhatsApp Cloud API ===
# From developers.facebook.com -> Your App -> WhatsApp -> API Setup
META_APP_ID=1234567890
META_APP_SECRET=your-meta-app-secret
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
# Long-lived system user token from Meta Business Suite
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxx_your_long_lived_token
# Your own random secret string used for webhook verification
WHATSAPP_VERIFY_TOKEN=my-random-verify-token-abc123

# === Database (auto-injected by Railway when you add plugins) ===
DATABASE_URL=postgresql://postgres:password@host:5432/railway
REDIS_URL=redis://default:password@host:6379

# === App ===
RAILWAY_PUBLIC_DOMAIN=https://your-app.up.railway.app
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-64-char-hex-secret-here
ENVIRONMENT=production
LOG_LEVEL=INFO
